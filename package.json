{
  "name": "shadcn-date-picker",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Anindo Sarker",
  "repository": "github:anindosarker/shadcn-date-picker",
  "type": "module",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.baseui.json && tsc -p tsconfig.radix.json && tsc -p tsconfig.aria.json",
    "registry:build": "node tools/registry-build.mjs",
    "registry:check": "node tools/registry-build.mjs --check",
    "test": "node --input-type=module -e \"import { execFileSync } from 'node:child_process'; import { BASES, readyBases } from './tools/bases.mjs'; const i = process.argv.indexOf('--base'); const bases = i > 0 ? [process.argv[i + 1]] : readyBases(); for (const base of bases) { if (!BASES.includes(base)) throw new Error('unknown base ' + base); execFileSync('vitest', ['run'], { stdio: 'inherit', env: { ...process.env, DP_BASE: base } }); }\"",
    "storybook": "storybook dev --no-open",
    "storybook:build": "node tools/site-build.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "npm:rolldown-vite@7.1.12",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.12"
    }
  }
}
