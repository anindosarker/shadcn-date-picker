{
  "name": "shadcn-date-picker-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --filter=shadcn-date-picker && prettier --check . \"!pnpm-lock.yaml\" \"!packages/shadcn-date-picker/registry/*/components/ui\" \"!packages/shadcn-date-picker/registry/*/hooks\"",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter shadcn-date-picker test",
    "registry:build": "pnpm --filter shadcn-date-picker registry:build",
    "registry:check": "pnpm --filter shadcn-date-picker registry:check",
    "storybook": "pnpm --filter shadcn-date-picker storybook",
    "storybook:build": "turbo run storybook:build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "turbo": "2.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.12"
    }
  }
}
