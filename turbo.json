{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tools/**", "packages/shadcn-date-picker/registry/**"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "storybook:build": {
      "outputs": ["storybook-static/**"]
    }
  }
}
